#!/bin/sh
# SPT-Txn pre-commit secret scan. Blocks a commit that would introduce a secret.
#
# Enable once per clone:  git config core.hooksPath .githooks
# Install gitleaks:       brew install gitleaks   (macOS)
#                         pkg_add gitleaks        (OpenBSD)
#
# The scan is required, not best-effort: with gitleaks absent this REFUSES the
# commit rather than reporting a skip and continuing. A hook that passes every
# commit when its scanner is missing reads, from the commit history, exactly
# like one that scanned and found nothing. Installing gitleaks is one command;
# `git commit --no-verify` is the deliberate way past it.

if ! command -v gitleaks >/dev/null 2>&1; then
    echo "" >&2
    echo "✗ gitleaks is not installed — commit blocked." >&2
    echo "  This hook does not pass a commit it has not scanned." >&2
    echo "  Install:  brew install gitleaks   /   pkg_add gitleaks" >&2
    echo "  Bypass deliberately (rare): git commit --no-verify" >&2
    exit 1
fi

if ! gitleaks protect --staged --redact --config .gitleaks.toml; then
    echo "" >&2
    echo "✗ gitleaks: potential secret in staged changes — commit blocked." >&2
    echo "  If it is a genuine false positive, add an allowlist entry in .gitleaks.toml." >&2
    echo "  To bypass intentionally (rare): git commit --no-verify" >&2
    exit 1
fi

exit 0
